# TalentMatch AI Configuration
APP_NAME="TalentMatch AI"
APP_ENV="development"
DEBUG=true
SECRET_KEY="supersecret-talentmatch-production-key-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For local development without Docker, SQLite is supported out of the box:
# DATABASE_URL="sqlite:///./talentmatch.db"
# For production PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/talentmatch"

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# AI/NLP Configuration
SPACY_MODEL="en_core_web_sm"

# Default Scoring Weights (Must total 100)
WEIGHT_REQUIRED_SKILLS=40
WEIGHT_PREFERRED_SKILLS=20
WEIGHT_EXPERIENCE=20
WEIGHT_EDUCATION=10
WEIGHT_TEXT_SIMILARITY=10
